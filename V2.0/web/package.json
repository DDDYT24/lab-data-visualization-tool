{
  "name": "labviz-web",
  "version": "2.1.1",
  "private": true,
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare:e2e": "node scripts/prepare-playwright.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:live": "playwright test e2e/live-api.spec.ts --project=chromium",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "9.2.0",
    "@mui/material": "9.2.0",
    "@mui/material-nextjs": "9.1.1",
    "@mui/x-data-grid": "9.10.1",
    "@tanstack/react-query": "^5.101.4",
    "echarts": "6.1.0",
    "echarts-for-react": "3.0.6",
    "echarts-gl": "^2.1.0",
    "next": "16.3.4",
    "next-intl": "4.13.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.24",
      "sharp": "0.35.4"
    }
  }
