        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "batch": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Batch",
          "type": "string"
        },
        "protocol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Protocol"
        }
      },
      "required": [
        "id",
        "batch",
        "protocol"
      ],
      "title": "Acquisition",
      "type": "object"
    },
    "Analysis": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Id",
          "type": "string"
        },
        "dataRevision": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Datarevision",
          "type": "string"
        },
        "method": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
