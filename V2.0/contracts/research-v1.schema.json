      "required": [
        "id",
        "dataRevision",
        "method",
        "methodVersion",
        "parametersJson",
        "seed",
        "analysisUnit",
        "inputObservationIds",
        "excluded",
        "independentUnitCount",
        "sampleCount",
        "observationCount",
        "resultJson"
