          "minItems": 1,
          "title": "Inputobservationids",
          "type": "array"
        },
        "excluded": {
          "items": {
            "$ref": "#/$defs/Exclusion"
          },
          "title": "Excluded",
          "type": "array"
        },
        "independentUnitCount": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
