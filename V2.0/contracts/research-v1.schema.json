        "sampleCount": {
          "minimum": 0,
          "title": "Samplecount",
          "type": "integer"
        },
        "observationCount": {
          "minimum": 1,
          "title": "Observationcount",
          "type": "integer"
        },
        "resultJson": {
          "title": "Resultjson",
          "type": "string"
        }
