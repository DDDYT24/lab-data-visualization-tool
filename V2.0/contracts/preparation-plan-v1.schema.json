      "title": "RoleMapping",
      "type": "object"
    },
    "WideStep": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "wide_to_long",
          "title": "Kind",
          "type": "string"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "nameField": {
          "title": "Namefield",
          "type": "string"
        },
        "valueField": {
          "title": "Valuefield",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "fields",
        "nameField",
        "valueField"
      ],
      "title": "WideStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "default": 1,
      "title": "Schemaversion",
      "type": "integer"
    },
    "mapping": {
      "$ref": "#/$defs/RoleMapping"
    },
    "steps": {
      "items": {
        "discriminator": {
          "mapping": {
            "convert_unit": "#/$defs/ConvertStep",
            "filter": "#/$defs/FilterStep",
            "long_to_wide": "#/$defs/LongStep",
            "wide_to_long": "#/$defs/WideStep"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/FilterStep"
          },
          {
            "$ref": "#/$defs/ConvertStep"
          },
          {
            "$ref": "#/$defs/WideStep"
          },
          {
            "$ref": "#/$defs/LongStep"
          }
        ]
      },
      "maxItems": 30,
      "title": "Steps",
      "type": "array"
    },
    "exclusions": {
      "items": {
        "$ref": "#/$defs/ExclusionDecision"
      },
      "title": "Exclusions",
      "type": "array"
    },
    "analysisUnit": {
      "default": "observation",
      "enum": [
        "experimental_unit",
        "sample",
        "observation"
      ],
      "title": "Analysisunit",
      "type": "string"
    },
    "validatePairs": {
      "default": false,
      "title": "Validatepairs",
      "type": "boolean"
    },
    "pairTimes": {
      "items": {
        "type": "string"
      },
      "maxItems": 2,
      "title": "Pairtimes",
      "type": "array"
    }
  },
  "required": [
    "mapping"
  ],
  "title": "PreparationPlan",
  "type": "object"
}
