# Local PostgreSQL development only. Do not reuse these credentials in a deployed environment.
LABVIZ_POSTGRES_USER=labviz
LABVIZ_POSTGRES_PASSWORD=labviz-local
LABVIZ_POSTGRES_DB=labviz
LABVIZ_POSTGRES_PORT=54329
LABVIZ_POSTGRES_URL=postgresql+psycopg://labviz:labviz-local@127.0.0.1:54329/labviz
LABVIZ_TEST_POSTGRES_URL=postgresql+psycopg://labviz:labviz-local@127.0.0.1:54329/labviz_test
LABVIZ_OBJECT_STORAGE_ROOT=.labviz/objects
# Select exactly one object backend. S3 never falls back to Local on configuration failure.
LABVIZ_OBJECT_STORAGE_BACKEND=local
LABVIZ_OBJECT_STORAGE_CURSOR_TTL_SECONDS=86400
# S3-compatible provider. Credentials come from the standard AWS provider chain.
LABVIZ_S3_BUCKET=replace-with-bucket-name
LABVIZ_S3_PREFIX=labviz/dev
LABVIZ_S3_REGION=us-east-1
# Set only for S3-compatible development services such as MinIO; omit for AWS S3.
LABVIZ_S3_ENDPOINT_URL=http://127.0.0.1:59000
LABVIZ_S3_MULTIPART_THRESHOLD_BYTES=16777216
LABVIZ_S3_MULTIPART_PART_SIZE_BYTES=8388608
LABVIZ_S3_CONNECT_TIMEOUT_SECONDS=5
LABVIZ_S3_READ_TIMEOUT_SECONDS=60
# Docker Compose MinIO development credentials only. Never reuse in a deployment.
LABVIZ_MINIO_ROOT_USER=labviz-minio
LABVIZ_MINIO_ROOT_PASSWORD=labviz-minio-local-only
LABVIZ_MINIO_BUCKET=labviz-test
LABVIZ_MINIO_PORT=59000
LABVIZ_MINIO_CONSOLE_PORT=59001
LABVIZ_SHARE_TOKEN_KEY_VERSION=1
LABVIZ_SHARE_TOKEN_KEYS=1=replace-with-at-least-32-random-characters
# Select exactly one project backend. SQLite remains the default reference implementation.
LABVIZ_PERSISTENCE_BACKEND=sqlite
# Phase 5B worker defaults are non-destructive. PostgreSQL workers run as a separate CLI.
LABVIZ_WORKER_BATCH_SIZE=25
LABVIZ_WORKER_LEASE_SECONDS=60
LABVIZ_WORKER_HEARTBEAT_SECONDS=20
LABVIZ_WORKER_POLL_SECONDS=5
LABVIZ_WORKER_BACKOFF_BASE_SECONDS=30
LABVIZ_WORKER_BACKOFF_MAX_SECONDS=3600
LABVIZ_WORKER_MAX_RETRIES=5
# Both settings must change deliberately before Project/object/staging deletion is possible.
LABVIZ_WORKER_DRY_RUN=true
LABVIZ_WORKER_DELETE_ENABLED=false
LABVIZ_WORKER_GC_ORPHAN_AGE_SECONDS=86400
LABVIZ_WORKER_ORPHAN_STAGING_GRACE_SECONDS=3600
# Retained for Phase 5B-1 runner compatibility; handlers use the two switches above.
LABVIZ_WORKER_DESTRUCTIVE_MAINTENANCE=false
