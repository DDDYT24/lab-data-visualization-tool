      "slug": "time-series",
      "visibility": "public",
      "filename": "01_time_series.csv",
      "mediaType": "text/csv",
      "format": "csv",
      "sheetName": null,
      "availableSheets": [],
      "headerRow": 1,
      "title": {
        "en": "Time-series response",
        "zh": "时间响应曲线"
      },
      "purpose": {
        "en": "Follow a measurement over time and inspect missing or unusual points.",
        "zh": "观察测量值随时间变化，并检查缺失或异常点。"
      },
      "learningGoal": {
        "en": "Learn when a line chart is appropriate and why quality findings matter.",
        "zh": "理解什么时候适合用折线图，以及为什么要先检查数据质量。"
      },
      "recommendedChart": "line",
      "difficulty": "beginner",
      "fields": [
        {
          "name": "time_min",
          "kind": "number",
          "role": "x",
          "titleEn": "Time",
          "titleZh": "时间"
        },
        {
          "name": "response_mV",
          "kind": "number",
          "role": "y",
          "titleEn": "Response",
          "titleZh": "响应"
        },
        {
          "name": "temperature_C",
          "kind": "number",
          "role": "series",
          "titleEn": "Temperature",
          "titleZh": "温度"
        }
      ],
      "rowCount": 24,
      "qualityIssues": [
        {
          "en": "One missing response and one unusual response are intentional.",
          "zh": "故意包含一个缺失响应值和一个异常响应值。"
        }
      ],
      "expectedQualityKinds": [
        "missing",
        "extreme-value"
      ],
      "answerKey": {
        "previewRows": 24,
        "recommendedChart": "line",
        "requiredQualityKinds": [
          "missing",
          "extreme-value"
        ],
        "exportFormats": [
          "png",
          "svg",
          "pdf"
        ]
      },
      "synthetic": true,
      "byteSize": 418
    },
